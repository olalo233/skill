#!/bin/sh
# Install the matt-dev suite into the current project (.agents/skills +
# .claude/skills symlinks + .skills-lock.json). Thin wrapper around
# scripts/install-base; extra flags (e.g. --apply, --update, --force)
# pass straight through. Dry-run unless --apply is given.
set -eu
REPO="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
exec python3 "$REPO/scripts/install-base" --project --source "$REPO" --ref HEAD --suite matt-dev "$@"
