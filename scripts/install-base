#!/usr/bin/env python3
"""Install skills from a pinned clone of this repository into agent skill directories.

Default is a dry run: pass --apply to change anything.

User-level install (default): symlinks the base suite into
  ~/.agents/skills, ~/.claude/skills, ~/.gemini/skills,
  ~/.gemini/config/skills, ~/.codex/skills
Project install (--project): copies each selected entity once into
  ./.agents/skills and places a relative symlink at ./.claude/skills,
  records ownership in ./.skills-lock.json, and never retires anything.

Payload never comes from the worktree: --ref is resolved to a commit and
the needed trees are exported (git archive) into an immutable,
content-addressed snapshot at
  <common target parent>/.install-base-snapshots/<commit>/
so untracked or ignored worktree files can never leak into an install and
links never drift with the checkout.

Skills are identified by their repository path (e.g.
vendor/matt/skills/engineering/tdd). A bare --skill name only resolves
when it is unique; ambiguous names are an error listing the qualified
candidates.

Every mutating step (retirement, replacement, install, index files, the
project lock) is an op journaled inside one backup directory. The journal
is rewritten atomically after every state transition, and the op that was
in flight when apply failed is rolled back too -- 'done' is not the
criterion, the recorded state is. --rollback <backup-dir> replays the
restore, but first verifies nothing was edited since the install; it
refuses rather than drop newer edits, and it reports failure honestly
without marking the backup consumed.

Suites are declared in suites/<name>.json inside the source tree:
  --project --suite matt-dev      install a suite (member closure listed there;
                                  a suite may `includes` other suite files,
                                  whose members merge in deduplicated by path
                                  and are owned in the lock by the final suite)

  --project --update --suite X    re-install at --ref; refuses when a member
                                  was edited locally unless --force (edited
                                  copy is moved to the backup dir first)
  --project --uninstall X         drop X from every member's required_by and
                                  remove only what no longer has an owner
"""
import argparse
import contextlib
import errno
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import itertools
from datetime import datetime
from pathlib import Path, PurePosixPath

DEFAULT_SOURCE = Path.home() / 'space/github/skill'
USER_TARGETS = [Path.home() / '.agents/skills',
                Path.home() / '.claude/skills',
                Path.home() / '.gemini/skills',
                Path.home() / '.gemini/config/skills',
                Path.home() / '.codex/skills']
PROJECT_PRIMARY = '.agents/skills'
PROJECT_LINK_ROOTS = ['.claude/skills']
INDEX_FILES = ['index.json', 'INDEX.md']
LOCK_NAME = '.skills-lock.json'
SNAP_DIRNAME = '.install-base-snapshots'
BACKUP_PREFIX = '.install-base-backup-'
SNAP_MARKER = '.snapshot-complete'
EXPLICIT = 'explicit'
NAME_RE = re.compile(r'^[A-Za-z0-9_.-]+$')
BASE_EXPORT_PATHS = ['.sync', 'suites', 'index.json', 'INDEX.md']


# ---------------------------------------------------------------- source pin

def resolve_commit(source, ref):
    """Resolve --ref to a full commit SHA inside --source (a clone)."""
    if not (source / '.git').exists():
        raise SystemExit(f'install-base: --source is not a clone: {source}')
    out = subprocess.run(['git', '-C', str(source), 'rev-parse', ref + '^{commit}'],
                         capture_output=True, text=True)
    sha = out.stdout.strip()
    if out.returncode or not re.fullmatch(r'[0-9a-f]{40}', sha or ''):
        raise SystemExit(f'install-base: --ref {ref!r} does not resolve to a commit in {source}')
    return sha


def _tar_members_safe(tf, dest):
    """Yield archive members after rejecting escapes and unsafe types."""
    dest = dest.resolve()
    for m in tf:
        rel = PurePosixPath(m.name)
        if rel.is_absolute() or '..' in rel.parts:
            raise SystemExit(f'install-base: unsafe path in archive: {m.name}')
        if m.issym() or m.islnk():
            resolved = (dest / rel).parent.joinpath(m.linkname).resolve()
            if resolved != dest and dest not in resolved.parents:
                raise SystemExit(f'install-base: unsafe link in archive: {m.name}')
        if m.isdir() or m.isreg() or m.issym():
            yield m, dest / rel


def _git_tree_index(source, sha, paths):
    """Expected (mode, blob sha1) per path straight from git objects at sha."""
    args = ['git', '-C', str(source), 'ls-tree', '-r', '--full-tree', '-z', sha]
    if paths != ['.']:
        args += ['--'] + sorted(paths)
    out = subprocess.run(args, capture_output=True)
    if out.returncode:
        raise SystemExit('install-base: git ls-tree failed for commit '
                         f'{sha}:\n{out.stderr.decode(errors="replace")}')
    expected = {}
    for record in out.stdout.decode(errors='surrogateescape').split('\0'):
        if not record:
            continue
        meta, path = record.split('\t', 1)
        mode, _typ, blob = meta.split(' ')
        expected[path] = (mode, blob)
    return expected


def _blob_sha1(data):
    return hashlib.sha1(b'blob %d\0' % len(data) + data).hexdigest()


def _snapshot_valid(dest, expected):
    """Verify the cached snapshot against git objects, entry by entry.

    A bare marker never certifies content: every blob at the commit must be
    present with matching content and executable bit, and nothing else may
    exist in the tree besides the marker.
    """
    expected_dirs = {parent for path in expected
                     for parent in PurePosixPath(path).parents
                     if str(parent) != '.'}
    seen = set()
    for p in dest.rglob('*'):
        rel = p.relative_to(dest).as_posix()
        if rel == SNAP_MARKER:
            continue
        if p.is_dir() and not p.is_symlink():
            if rel not in expected_dirs:
                return False
            continue
        exp = expected.get(rel)
        if exp is None:
            return False
        mode, blob = exp
        if p.is_symlink():
            if mode != '120000' or _blob_sha1(os.readlink(p).encode()) != blob:
                return False
        elif p.is_file():
            if mode not in ('100644', '100755') or _blob_sha1(p.read_bytes()) != blob:
                return False
            if bool(p.stat().st_mode & 0o100) != (mode == '100755'):
                return False
        else:
            return False
        seen.add(rel)
    return seen == set(expected)


def export_snapshot(source, sha, paths, snap_root):
    """Export `paths` of commit `sha` into snap_root/sha (immutable).

    Extraction goes through a temp dir renamed into place, so a concurrent
    or crashed run never leaves a half-written snapshot; executable bits from
    the archive are restored. A cached snapshot is reused only after every
    entry verifies against the commit's git objects; drift is rebuilt.
    Returns the snapshot directory.
    """
    dest = snap_root / sha
    expected = _git_tree_index(source, sha, paths)
    if (dest / SNAP_MARKER).is_file() and _snapshot_valid(dest, expected):
        return dest
    if dest.exists():
        shutil.rmtree(dest)  # partial export or drifted cache: rebuild it
    snap_root.mkdir(parents=True, exist_ok=True)
    gitignore = snap_root / '.gitignore'
    if not gitignore.exists():
        gitignore.write_text('*\n')
    tmp = Path(tempfile.mkdtemp(prefix=f'.{sha}.', dir=str(snap_root)))
    try:
        pathspec = [] if paths == ['.'] else ['--'] + sorted(paths)
        proc = subprocess.run(['git', '-C', str(source), 'archive', sha] + pathspec,
                              capture_output=True)
        if proc.returncode:
            raise SystemExit('install-base: git archive failed for commit '
                             f'{sha}:\n{proc.stderr.decode(errors="replace")}')
        with tarfile.open(fileobj=io.BytesIO(proc.stdout)) as tf:
            for m, target in _tar_members_safe(tf, tmp):
                if m.isdir():
                    target.mkdir(parents=True, exist_ok=True)
                elif m.isreg():
                    target.parent.mkdir(parents=True, exist_ok=True)
                    with tf.extractfile(m) as fh:
                        target.write_bytes(fh.read())
                    os.chmod(target, 0o755 if m.mode & 0o111 else 0o644)
                else:  # symlink
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.symlink_to(m.linkname)
        (tmp / SNAP_MARKER).write_text(sha + '\n')
        try:
            os.rename(tmp, dest)
        except OSError:
            if (dest / SNAP_MARKER).is_file() and \
                    _snapshot_valid(dest, expected):  # another run won the race
                shutil.rmtree(tmp, ignore_errors=True)
                return dest
            raise
        return dest
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


# ------------------------------------------------------------ index/identity

def git_show(source, sha, path):
    """Read one file out of a commit; None when absent."""
    out = subprocess.run(['git', '-C', str(source), 'show', f'{sha}:{path}'],
                         capture_output=True)
    return out.stdout if out.returncode == 0 else None


def parse_source_index(index_text, src_text, where):
    try:
        index = json.loads(index_text)
        src = json.loads(src_text)
    except (TypeError, json.JSONDecodeError) as exc:
        raise SystemExit(f'install-base: cannot read index in {where}: {exc}')
    base = src['suites']['base']['skills']
    return index['skills'], base, src.get('retired', {}), src


def load_source_index(root):
    """Read index.json and .sync/index-source.json from a tree on disk."""
    try:
        return parse_source_index((root / 'index.json').read_text(),
                                  (root / '.sync/index-source.json').read_text(), root)
    except OSError as exc:
        raise SystemExit(f'install-base: cannot read index in {root}: {exc}')


def skill_dir(entry):
    """Repository-relative directory of an index entry (its identity)."""
    return entry['path'].rsplit('/', 1)[0]


def load_repo_map(upstreams_text):
    """Map repo-relative prefixes to upstream repo slugs."""
    try:
        manifest = json.loads(upstreams_text)
    except (TypeError, json.JSONDecodeError):
        return {}
    repo_map = {}
    for source in manifest.get('sources', []):
        for group in ('paths', 'vendor_paths'):
            for mapping in source.get(group, []):
                repo_map[mapping['destination'].rstrip('/')] = source['repo']
    return repo_map


def collection_repo(source):
    """Portable identity of the collection clone ('local' when no remote)."""
    remote = subprocess.run(['git', '-C', str(source), 'config', 'remote.origin.url'],
                            capture_output=True, text=True).stdout.strip()
    return remote or 'local'


def upstream_repo_for(path, repo_map):
    """Upstream slug a repo-relative path was synced from (None when local)."""
    best, hit = '', None
    for dest, repo in repo_map.items():
        if (path == dest or path.startswith(dest + '/')) and len(dest) > len(best):
            best, hit = dest, repo
    return hit


def license_map_for(upstreams_text):
    """Destination dir -> license files its upstream source declares."""
    try:
        manifest = json.loads(upstreams_text)
    except (TypeError, json.JSONDecodeError):
        return {}
    out = {}
    for source in manifest.get('sources', []):
        licenses = [m['destination'] for m in source.get('paths', [])
                    if PurePosixPath(m['destination']).parts[0] == 'licenses']
        if not licenses:
            continue
        for group in ('paths', 'vendor_paths', 'derived_paths'):
            for mapping in source.get(group, []):
                dest = mapping['destination'].rstrip('/')
                if PurePosixPath(dest).parts[0] in ('skills', 'vendor'):
                    out.setdefault(dest, []).extend(licenses)
    return out


LEGAL_RE = re.compile(r'^(LICENSE|NOTICE)', re.I)


def legal_files_for(member_path, snap, license_map):
    """(file, install name) legal material a member payload still lacks.

    A member dir carrying its own LICENSE/NOTICE needs nothing. Otherwise
    the nearest ancestor's legal files apply (vendor roots carry upstream's
    copies); for curated skills the source's declared licenses/* files are
    injected, and the repository LICENSE covers local content.
    """
    mdir = snap / member_path
    if mdir.is_dir() and any(f.is_file() and LEGAL_RE.match(f.name)
                             for f in mdir.iterdir()):
        return []
    parts = PurePosixPath(member_path).parts
    for i in range(len(parts) - 1, 0, -1):
        cand_dir = snap / '/'.join(parts[:i])
        hits = sorted(f for f in cand_dir.iterdir()
                      if f.is_file() and LEGAL_RE.match(f.name))
        if hits:
            return [(h, h.name) for h in hits]
    best, hits = '', []
    for dest, licenses in license_map.items():
        if (member_path == dest or member_path.startswith(dest + '/')) \
                and len(dest) > len(best):
            best, hits = dest, licenses
    out = []
    for rel in hits:
        f = snap / rel
        if f.is_file():
            out.append((f, 'LICENSE' if len(hits) == 1 else f.name))
    if out:
        return out
    root_hits = sorted(f for f in snap.iterdir()
                       if f.is_file() and LEGAL_RE.match(f.name))
    return [(h, h.name) for h in root_hits]


def resolve_selectors(selectors, entries):
    """Resolve --skill selectors to unique index entries.

    A selector is either a repository path (the skill's directory) or a
    bare name that must be unique across the index; ambiguous bare names
    are an error that prints the qualified candidates.
    """
    by_dir = {}
    by_name = {}
    for e in entries:
        by_dir[skill_dir(e)] = e
        by_name.setdefault(e['name'], []).append(e)
    picked, seen = [], set()
    for sel in selectors:
        entry = by_dir.get(sel)
        if entry is None:
            cands = by_name.get(sel, [])
            # skills/ is the curated set; a vendored copy of the same name is
            # the upstream original, so a bare name resolves to the curated
            # one. Ambiguity *within* vendor trees (or within skills/) is a
            # hard error -- qualify by repository path.
            curated = [c for c in cands if skill_dir(c).startswith('skills/')]
            cands = curated if len(curated) == 1 else cands
            if not cands:
                raise SystemExit(f'Unknown skill: {sel} (not a name or path in index.json)')
            if len(cands) > 1:
                where = '\n'.join(f'  {skill_dir(c)}' for c in cands)
                raise SystemExit(f'Ambiguous skill name {sel!r}; qualify by path:\n{where}')
            entry = cands[0]
        key = skill_dir(entry)
        if key not in seen:
            seen.add(key)
            picked.append(entry)
    return picked


def closure(roots, entries):
    """Expand entries with their dependency closure, in install order."""
    by_name = {}
    for e in entries:
        by_name.setdefault(e['name'], []).append(e)
    picked, seen = [], set()

    def dep_entry(name, want_suite):
        cands = by_name.get(name, [])
        same = [c for c in cands if c['suite'] == want_suite]
        cands = same or [c for c in cands if skill_dir(c).startswith('skills/')] or cands
        if not cands:
            raise SystemExit(f'Unknown dependency: {name} (not in index.json)')
        if len(cands) > 1:
            where = ', '.join(skill_dir(c) for c in cands)
            raise SystemExit(f'Ambiguous dependency {name!r}: {where}')
        return cands[0]

    def add(entry):
        key = skill_dir(entry)
        if key in seen:
            return
        for dep in entry['depends']:
            add(dep_entry(dep, entry['suite']))
        seen.add(key)
        picked.append(entry)

    for entry in roots:
        add(entry)
    return picked


def retired_names(retired, target):
    """Retired entries for one target: the '*' list plus per-directory names."""
    names = list(retired.get('*', []))
    for key, extra in retired.items():
        if key != '*' and Path(key).expanduser().resolve() == target:
            names.extend(extra)
    return sorted(set(names))


# ------------------------------------------------------------------- digests

def _file_sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def _tree_records(path):
    """Canonical (relpath, kind, exec, content-sha256) records for a tree."""
    def rec(p, rel):
        if p.is_symlink():
            return (rel, 'link', '-',
                    hashlib.sha256(os.readlink(p).encode()).hexdigest())
        if p.is_dir():
            return (rel, 'dir', '-', '')
        if p.is_file():
            return (rel, 'file', 'x' if os.stat(p).st_mode & 0o111 else '-',
                    _file_sha256(p))
        return (rel, 'other', '-', '')
    if path.is_symlink() or path.is_file():
        yield rec(path, '.')
        return
    for p in sorted(path.rglob('*'), key=lambda q: q.as_posix()):
        yield rec(p, p.relative_to(path).as_posix())


def tree_digest(path):
    """sha256 over unambiguous per-entry canonical records.

    Each record is `<kind> <len>:<relpath> <exec> <content-sha256>` -- every
    file's content is hashed on its own and the path is length-prefixed, so
    different trees cannot serialize into the same stream, and the
    executable bit is part of the identity.
    """
    h = hashlib.sha256()
    for rel, kind, exe, content in _tree_records(path):
        h.update(f'{kind} {len(rel)}:{rel} {exe} {content}\n'.encode())
    return h.hexdigest()


def describe(path):
    """State fingerprint used to detect edits after install."""
    if path.is_symlink():
        return {'kind': 'link', 'sha256': tree_digest(path)}
    if path.is_file():
        return {'kind': 'file', 'sha256': tree_digest(path)}
    if path.is_dir():
        return {'kind': 'dir', 'sha256': tree_digest(path)}
    return {'kind': 'absent', 'sha256': 'absent'}


# ------------------------------------------------------------------ suites

def parse_suite(text, name):
    """Validate one suites/<name>.json: member paths are safe, names match
    directories, includes are well-formed. Dependency closure is checked by
    expand_suite once includes are merged in."""
    if not NAME_RE.fullmatch(name):
        raise SystemExit(f'install-base: bad suite name: {name!r}')
    if text is None:
        raise SystemExit(f'install-base: no suite {name!r} in source '
                         f'(looked at suites/{name}.json)')
    suite = json.loads(text)
    by_name = {}
    for m in suite.get('members', []):
        rel = PurePosixPath(m['path'])
        if not NAME_RE.fullmatch(m['name']) or rel.is_absolute() or '..' in rel.parts:
            raise SystemExit(f'install-base: unsafe member in suite {name}: {m}')
        if m['name'] in by_name:
            raise SystemExit(f'install-base: duplicate member {m["name"]!r} in suite {name}')
        if m['name'] != rel.name:
            raise SystemExit(f"install-base: suite {name}: member {m['name']} must live in a "
                             f'same-named directory ({m["path"]})')
        by_name[m['name']] = m
    for inc in suite.get('includes', []):
        if not NAME_RE.fullmatch(inc):
            raise SystemExit(f'install-base: bad included suite name in {name}: {inc!r}')
        if inc == name:
            raise SystemExit(f'install-base: suite {name} includes itself')
    return suite


def expand_suite(load, name, stack=()):
    """Resolve a suite's `includes` into one ordered member list.

    `load` maps a suite name to its suites/<name>.json text (None if absent).
    Included suites contribute their members first; members are deduplicated
    by repository path, which pins the content digest inside one commit. The
    same member name at two different paths is a hard error. Every depends
    entry must be an explicit member of the suite or of an included suite.
    Returns (top-level suite object, members in dependency order).
    """
    if name in stack:
        raise SystemExit('install-base: suite include cycle: '
                         + ' -> '.join(stack + (name,)))
    suite = parse_suite(load(name), name)
    members, order = {}, []
    for inc in suite.get('includes', []):
        for m in expand_suite(load, inc, stack + (name,))[1]:
            if m['name'] in members and members[m['name']]['path'] != m['path']:
                raise SystemExit(
                    f"install-base: suite {name}: member {m['name']!r} at both "
                    f"{members[m['name']]['path']} and {m['path']}")
            if m['name'] not in members:
                members[m['name']] = m
                order.append(m)
    for m in suite.get('members', []):
        if m['name'] in members and members[m['name']]['path'] != m['path']:
            raise SystemExit(
                f"install-base: suite {name}: member {m['name']!r} at both "
                f"{members[m['name']]['path']} and {m['path']}")
        if m['name'] not in members:
            members[m['name']] = m
            order.append(m)
    for m in order:
        for dep in m.get('depends', []):
            if dep not in members:
                raise SystemExit(
                    f"install-base: suite {name}: {m['name']} depends on {dep!r}, "
                    'which is not a member of the suite or its includes')
    ordered, seen = [], set()

    def visit(m):
        if m['name'] in seen:
            return
        for dep in m.get('depends', []):
            visit(members[dep])
        seen.add(m['name'])
        ordered.append(m)

    for m in order:
        visit(m)
    return suite, ordered


def check_final_names(members):
    """No two selected entities may install under the same target name."""
    seen = {}
    for m in members:
        other = seen.get(m['name'])
        if other and other != m['path']:
            raise SystemExit(
                f"install-base: '{m['name']}' resolves to two sources "
                f"({other} and {m['path']}); one installed name can hold only "
                'one entity')
        seen[m['name']] = m['path']


def _write_askme_provenance(staged, mpath, snap, meta):
    """Write source.json (with per-skill and per-file digests) + index files."""
    skill_digests, file_digests = {}, {}
    for e in meta.get('entries', []):
        edir = skill_dir(e)
        esnap = snap / edir
        if not esnap.is_dir() or edir in skill_digests:
            continue
        skill_digests[edir] = tree_digest(esnap)
        for p in sorted(esnap.rglob('*')):
            if p.is_file() and not p.is_symlink():
                file_digests[p.relative_to(snap).as_posix()] = _file_sha256(p)
    (staged / 'source.json').write_text(json.dumps({
        'repo': meta['collection_id'],
        'upstream': upstream_repo_for(mpath, meta['repo_map']),
        'commit': meta['sha'],
        'source_path': mpath,
        'snapshot_root': f'{SNAP_DIRNAME}/{meta["sha"]}',
        'skill_digests': skill_digests,
        'file_digests': file_digests}, indent=2) + '\n')
    for fname in INDEX_FILES:
        if (snap / fname).is_file():
            shutil.copy2(str(snap / fname), str(staged / fname))


def stage_payloads(members, snap, meta, stage_root):
    """Final payload dir per member: the snapshot copy plus, when needed,
    injected provenance (ask-me) and legal files, staged as one entity so
    the digest describes exactly what lands on disk.
    """
    payloads = {}
    for m in members:
        src = snap / m['path']
        extra = list(legal_files_for(m['path'], snap, meta['license_map']))
        is_askme = m['name'] == 'ask-me'
        if not extra and not is_askme:
            payloads[m['name']] = src
            continue
        staged = stage_root / m['name']
        shutil.copytree(str(src), str(staged), symlinks=True)
        for f, dest_name in extra:
            shutil.copy2(str(f), str(staged / dest_name))
        if is_askme:
            _write_askme_provenance(staged, m['path'], snap, meta)
        payloads[m['name']] = staged
    return payloads


def stage_user_payloads(members, snap, meta, snap_root, sha):
    """Persistent staged payload dirs for user-level installs: members whose
    snapshot copy lacks legal files, plus ask-me (so user installs also
    carry source.json with snapshot digests and index files).
    Returns {member name: payload dir} for augmented members only."""
    license_map = meta['license_map']
    need = {}
    for m in members:
        extra = list(legal_files_for(m['path'], snap, license_map))
        if extra or m['name'] == 'ask-me':
            need[m['name']] = (m['path'], extra)
    if not need:
        return {}
    # per-member replacement: previously staged members from other installs
    # must stay put, since installed symlinks still point into them
    final = snap_root / f'{sha}.payloads'
    final.mkdir(parents=True, exist_ok=True)
    for name, (mpath, extra) in need.items():
        dst = final / name
        tmp = final / f'.{name}.ibstage-{os.getpid()}'
        old = final / f'.{name}.ibold-{os.getpid()}'
        if tmp.exists():
            shutil.rmtree(tmp)
        if old.exists():
            shutil.rmtree(old)
        try:
            shutil.copytree(str(snap / mpath), str(tmp), symlinks=True)
            for f, dest_name in extra:
                shutil.copy2(str(f), str(tmp / dest_name))
            if name == 'ask-me':
                _write_askme_provenance(tmp, mpath, snap, meta)
            if dst.is_dir() and not dst.is_symlink() \
                    and tree_digest(dst) == tree_digest(tmp):
                shutil.rmtree(tmp)
                continue
            if dst.exists() or dst.is_symlink():
                os.rename(dst, old)
            try:
                os.rename(tmp, dst)
            except BaseException:
                if (old.exists() or old.is_symlink()) \
                        and not (dst.exists() or dst.is_symlink()):
                    try:
                        os.rename(old, dst)
                    except OSError:
                        pass
                raise
            if old.exists() or old.is_symlink():
                remove(old)
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
    return {name: final / name for name in need}


def make_backup_dir(backup_dir):
    """Create the backup dir already opted out of version control: its
    manifest holds absolute paths and --force evicts user edits into it."""
    backup_dir.mkdir(parents=True)
    gitignore = backup_dir / '.gitignore'
    if not gitignore.exists():
        gitignore.write_text('*\n')


# --------------------------------------------------------------------- ops

def backup_dir_for(targets, ts):
    parents = [t.parent for t in targets]
    try:
        base = Path(os.path.commonpath([str(p) for p in parents])) if len(parents) > 1 else parents[0]
    except ValueError:
        base = parents[0]
    candidate = base / f'{BACKUP_PREFIX}{ts}'
    n = 1
    while candidate.exists():
        n += 1
        candidate = base / f'{BACKUP_PREFIX}{ts}-{n}'
    return candidate


_EVICT_SEQ = itertools.count()


def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def _injected(op):
    """Test hook: INSTALL_BASE_FAIL='op:substr' fails that op mid-apply,
    after any eviction already happened (an intra-op partial failure).
    'restore:substr' fails the backup->target move inside rollback, after
    the new payload was already removed."""
    needle = os.environ.get('INSTALL_BASE_FAIL')
    if needle and ':' in needle:
        kind, sub = needle.split(':', 1)
        if op['op'] == kind and sub in op['path']:
            raise OSError(f'injected failure at {kind} {op["path"]}')


def _copy_tree(src, dst):
    """Copy a file, symlink or directory tree onto dst (dst absent)."""
    if src.is_symlink():
        dst.symlink_to(os.readlink(src))
    elif src.is_file():
        shutil.copy2(str(src), str(dst))
    else:
        shutil.copytree(str(src), str(dst), symlinks=True)


def _evict(path, dest, op, save=None):
    """Move `path` into the backup dir without ever losing the original.

    Same-device rename is atomic. A cross-device move degenerates into a
    copy that is verified against the op's recorded `before` state and
    journaled (`backup_committed`) BEFORE the original is removed; a
    partial or unverifiable copy is cleaned up with `path` left intact.
    """
    if 'before' not in op:
        op['before'] = describe(path)
    try:
        os.rename(path, dest)
    except OSError as exc:
        if exc.errno != errno.EXDEV:
            raise
        try:
            _copy_tree(path, dest)
            if describe(dest) != op['before']:
                raise OSError(f'backup copy of {path} does not match the '
                              'recorded original')
        except BaseException:
            if dest.exists() or dest.is_symlink():
                remove(dest)
            raise
        op['backup_committed'] = True
        if save:
            save()
        remove(path)
    else:
        op['backup_committed'] = True
        if save:
            save()


def _move_verified(src, dst, want, on_landed=None):
    """Move src to dst without ever leaving a half-copied payload at dst.

    Rename when possible; otherwise copy into a sibling temp, verify the
    copy against `want`, rename it into place, and only then remove src.
    """
    try:
        os.rename(src, dst)
    except OSError as exc:
        if exc.errno != errno.EXDEV:
            raise
        tmp = dst.parent / f'.{dst.name}.ibrestore-{os.getpid()}'
        try:
            _copy_tree(src, tmp)
            if want and describe(tmp) != want:
                raise OSError(f'restored copy of {dst} does not match the '
                              'recorded original')
            os.rename(tmp, dst)
        except BaseException:
            if tmp.exists() or tmp.is_symlink():
                remove(tmp)
            raise
        if on_landed:
            on_landed()
        remove(src)
    else:
        if on_landed:
            on_landed()


def _stage_dir(src, path):
    """copytree into a sibling temp, then rename into place."""
    tmp = path.parent / f'.{path.name}.ibstage-{os.getpid()}'
    if tmp.exists():
        shutil.rmtree(tmp)
    try:
        shutil.copytree(str(src), str(tmp), symlinks=True)
        os.rename(tmp, path)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def _stage_file(src, path):
    tmp = path.parent / f'.{path.name}.ibstage-{os.getpid()}'
    try:
        shutil.copy2(str(src), str(tmp))
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def _stage_text(path, text):
    tmp = path.parent / f'.{path.name}.ibstage-{os.getpid()}'
    try:
        tmp.write_text(text)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def apply_op(op, backup_dir, save=None):
    path = Path(op['path'])
    if op['op'] == 'mkdir':
        path.mkdir(parents=True, exist_ok=True)
        return
    if op['op'] == 'move':
        dest = backup_dir / op['backup']
        dest.parent.mkdir(parents=True, exist_ok=True)
        _injected(dict(op, op='evict'))  # test hook for a failed eviction
        _evict(path, dest, op, save)
        return
    # evict-and-install ops: any pre-existing path is moved into the backup
    # BEFORE the new content lands, so a mid-op failure still leaves the
    # old content recoverable through op['backup'].
    if path.exists() or path.is_symlink():
        rel = op.get('backup') or f'files/evicted-{os.getpid()}-{next(_EVICT_SEQ)}-{path.name}'
        op['backup'] = rel
        if save:
            save()  # journal the backup name before any content moves
        _injected(dict(op, op='evict'))  # test hook for a failed eviction
        dest = backup_dir / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        _evict(path, dest, op, save)
    _injected(op)
    if op['op'] == 'copy':
        _stage_dir(Path(op['from']), path)
    elif op['op'] == 'copy-file':
        _stage_file(Path(op['from']), path)
    elif op['op'] == 'link':
        path.symlink_to(op['target'])
    elif op['op'] == 'write-json':
        _stage_text(path, json.dumps(op['data'], indent=2) + '\n')
    else:
        raise SystemExit(f'install-base: unknown op {op["op"]}')


def _restore_target_landed(op, path):
    """True when a previous restore already placed and verified the original
    payload at `path`, but died before finishing backup cleanup or saving
    `restored=True`."""
    before = op.get('before') or {}
    return bool(op.get('restore_stage')) \
        and before.get('kind') not in (None, 'absent') \
        and describe(path) == before


def _restore_resumable(op, path, stored):
    """True when this op died mid-restore in a state that is safe to
    continue: either the original is already back in place at `path`, or the
    new payload is already gone (restore_stage reached 'target_removed') and
    the recorded original either verifies in the backup or was absent to
    begin with."""
    if _restore_target_landed(op, path):
        return True
    if op.get('restore_stage') != 'target_removed':
        return False
    if path.exists() or path.is_symlink():
        return False
    before = op.get('before') or {}
    if before.get('kind') == 'absent':
        return True
    return stored is not None and (stored.exists() or stored.is_symlink()) \
        and describe(stored) == before


def rollback(ops, backup_dir, verify, save=None):
    """Undo recorded ops, newest first. Returns (problems, errors).

    With verify, ops whose recorded post-state no longer matches are
    reported as problems and nothing is touched -- a rollback never drops
    edits made after the install. Restore failures are returned, never
    silently swallowed. Every op carries its recorded `before` state, so a
    path is deleted only when the original is safe in the backup (or the
    install itself confirmed the new content landed); an op whose eviction
    never committed a verified backup keeps whatever sits at its path.
    Each op restored is flagged `restored` and persisted through `save`,
    and the intermediate 'target_removed' stage is journaled too, so a
    retry continues where a partial restore stopped instead of mistaking
    restored or mid-restore paths for post-install edits.
    """
    live = [op for op in reversed(ops)
            if (op.get('state') in ('active', 'done') or op.get('done'))
            and not op.get('restored')]
    problems = []
    if verify:
        for op in live:
            after = op.get('after')
            if not after:
                continue
            path = Path(op['path'])
            stored = backup_dir / op['backup'] if op.get('backup') else None
            if op.get('restore_stage'):
                if _restore_resumable(op, path, stored):
                    continue  # last restore died mid-op; resume below
                before = op.get('before') or {}
                backup_intact = before.get('kind') == 'absent' or (
                    stored is not None
                    and (stored.exists() or stored.is_symlink())
                    and describe(stored) == before
                )
                if describe(path) == after and backup_intact:
                    # the recorded stage never landed (died before/inside
                    # remove); restart this op from scratch
                    op.pop('restore_stage', None)
                    if save:
                        save()
                    continue
                problems.append(f'{path}: a previous restore was interrupted '
                                'and neither the installed state nor the '
                                'original verifies; manual recovery needed')
                continue
            if after.get('kind') == 'absent':
                if path.exists() or path.is_symlink():
                    problems.append(f"{op['path']} was re-created after install")
            elif after.get('sha256') not in (None, 'absent') \
                    and describe(path) != after:
                problems.append(f'{path} changed since install '
                                f"(was {after['kind']} {after['sha256'][:12]}…)")
        if problems:
            return problems, []
    errors = []
    for op in live:
        path = Path(op['path'])
        try:
            if op['op'] == 'mkdir':
                if path.is_dir() and not any(path.iterdir()):
                    path.rmdir()
                op['restored'] = True
                if save:
                    save()
                continue
            stored = backup_dir / op['backup'] if op.get('backup') else None
            before = op.get('before') or {}
            if _restore_target_landed(op, path):
                if stored is not None and (stored.exists() or stored.is_symlink()):
                    remove(stored)
                op.pop('restore_stage', None)
                op['restored'] = True
                if save:
                    save()
                continue
            # 'backup exists' is not proof of a usable backup: it must have
            # been journaled as committed during apply, or verify against
            # the recorded original right now.
            stored_ok = stored is not None \
                and (stored.exists() or stored.is_symlink()) \
                and (op.get('backup_committed') or describe(stored) == before)
            if op.get('state') != 'done' and not stored_ok \
                    and before.get('kind') != 'absent':
                # the eviction never committed a backup: whatever sits at
                # path may be the un-backed-up original, so it is never
                # deleted here. Identical means intact and already restored.
                if describe(path) == before:
                    op['restored'] = True
                    op.pop('restore_stage', None)
                    if save:
                        save()
                else:
                    errors.append(f'{path}: content differs from the recorded '
                                  'original but no complete backup was '
                                  'committed; left in place')
                continue
            if op.get('backup') and not stored_ok and op.get('state') == 'done':
                errors.append(f'{path}: recorded backup {op["backup"]} is '
                              'missing or incomplete; left in place')
                continue
            op['restore_stage'] = 'restoring'
            if save:
                save()
            if path.exists() or path.is_symlink():
                remove(path)
            op['restore_stage'] = 'target_removed'
            if save:
                save()
            if stored_ok:
                path.parent.mkdir(parents=True, exist_ok=True)
                _injected(dict(op, op='restore'))  # test hook
                def _mark_landed(cur=op):
                    cur['restore_stage'] = 'target_restored'
                    if save:
                        save()
                _move_verified(stored, path,
                               before if before.get('kind') != 'absent' else None,
                               on_landed=_mark_landed)
            op.pop('restore_stage', None)
            op['restored'] = True
            if save:
                save()
        except OSError as exc:
            if save:
                save()  # persist restore_stage so a retry can resume
            errors.append(f'{path}: {exc}')
    return problems, errors


def write_json_atomic(path, data):
    tmp = path.parent / f'.{path.name}.ibtmp-{os.getpid()}'
    try:
        tmp.write_text(json.dumps(data, indent=2) + '\n')
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def run_ops(ops, backup_dir, manifest, manifest_path):
    """Execute ops with a per-transition atomic journal; roll back on failure."""
    def save():
        write_json_atomic(manifest_path, manifest)
    manifest.setdefault('tx_state', 'applying')
    try:
        for op in ops:
            op['before'] = describe(Path(op['path']))
            op['state'] = 'active'
            save()  # journal before acting
            apply_op(op, backup_dir, save)
            op['state'] = 'done'
            # mkdir: later ops fill the directory, so a content digest here
            # would false-positive as 'edited'; presence is all we verify
            op['after'] = {'kind': 'dir', 'sha256': None} if op['op'] == 'mkdir' \
                else describe(Path(op['path']))
            save()
        manifest['completed'] = True
        manifest['tx_state'] = 'applied'
        save()
    except Exception as exc:
        problems, errors = rollback(ops, backup_dir, verify=False, save=save)
        if errors:
            manifest['rolled_back'] = False
            manifest['tx_state'] = 'rollback-failed'
            manifest['rollback_errors'] = errors
            write_json_atomic(manifest_path, manifest)
            raise SystemExit(
                f'\ninstall-base: failed at {op["op"]} {op["path"]}: {exc}\n'
                f'rollback itself FAILED for {len(errors)} path(s); manual recovery needed:\n  '
                + '\n  '.join(errors) + f'\nbackup kept at {backup_dir}')
        manifest['rolled_back'] = True
        manifest['tx_state'] = 'rolled-back'
        write_json_atomic(manifest_path, manifest)
        raise SystemExit(f'\ninstall-base: failed at {op["op"]} {op["path"]}: {exc}\n'
                         f'previous state restored; backup kept at {backup_dir}')


def do_rollback(backup_dir):
    manifest_path = backup_dir / 'manifest.json'
    if not manifest_path.is_file():
        raise SystemExit(f'install-base: no manifest in {backup_dir}')
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('rolled_back') or manifest.get('tx_state') == 'rolled-back':
        print(f'{backup_dir}: already rolled back.')
        return
    # project installs and project uninstalls are the same transaction
    # scope: both restore under the project-root mutex, and the journal is
    # re-read only after the lock is taken. User-mode restores lock inside
    # their own backup dir.
    if manifest.get('mode') in ('project', 'uninstall'):
        lock_root = Path(manifest.get('root', backup_dir.parent))
        guard = Mutex(lock_root / (LOCK_NAME + '.lock'))
    else:
        guard = Mutex(backup_dir / 'manifest.json.lock')
    with guard:
        manifest = json.loads(manifest_path.read_text())
        if manifest.get('rolled_back') or manifest.get('tx_state') == 'rolled-back':
            print(f'{backup_dir}: already rolled back.')
            return
        def save():
            write_json_atomic(manifest_path, manifest)
        restoring = any(o.get('restored') or o.get('restore_stage')
                        for o in manifest['ops'])
        if restoring:
            manifest['tx_state'] = 'rolling-back'
            save()
        problems, errors = rollback(manifest['ops'], backup_dir, verify=True,
                                  save=save)
        restoring = any(o.get('restored') or o.get('restore_stage')
                        for o in manifest['ops'])
        if problems:
            manifest['rollback_attempted'] = datetime.now().isoformat(timespec='seconds')
            manifest['rollback_errors'] = problems
            if restoring or not manifest.get('completed'):
                manifest['tx_state'] = 'rollback-failed'
            else:
                manifest['tx_state'] = 'rollback-refused'
            write_json_atomic(manifest_path, manifest)
            raise SystemExit('install-base: refusing to roll back; edits made after the '
                             'install would be lost:\n  ' + '\n  '.join(problems) +
                             f'\nbackup kept at {backup_dir}')
        if errors:
            manifest['rollback_attempted'] = datetime.now().isoformat(timespec='seconds')
            manifest['rollback_errors'] = errors
            manifest['tx_state'] = 'rollback-failed'
            write_json_atomic(manifest_path, manifest)
            raise SystemExit('install-base: rollback incomplete; not marked as restored. '
                             'Fix the causes and re-run --rollback:\n  ' + '\n  '.join(errors))
        manifest['rolled_back'] = True
        manifest['tx_state'] = 'rolled-back'
        write_json_atomic(manifest_path, manifest)
    print(f'Restored from {backup_dir}.')


def verify_source(source_json):
    """Verify an installed ask-me payload's recorded snapshot content.

    Reads source.json (accepts the file or its skill dir), finds the
    snapshot root it names by walking up from the install location, and
    checks the completion marker plus every file recorded in
    `file_digests`. Returns a list of problems ([] means verified).
    """
    sj = Path(source_json)
    if sj.is_dir():
        sj = sj / 'source.json'
    if not sj.is_file():
        raise SystemExit(f'install-base: no source.json at {source_json}')
    try:
        meta = json.loads(sj.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f'install-base: cannot read {sj}: {exc}')
    snap_rel = meta.get('snapshot_root')
    commit = meta.get('commit')
    digests = meta.get('file_digests')
    if not isinstance(snap_rel, str) or not commit or not isinstance(digests, dict):
        raise SystemExit(f'install-base: {sj} lacks snapshot_root, commit '
                         'or file_digests')
    snap = None
    for parent in sj.resolve().parents:
        cand = parent / snap_rel
        if (cand / SNAP_MARKER).is_file():
            snap = cand
            break
    if snap is None:
        raise SystemExit(f'install-base: snapshot {snap_rel} not found '
                         f'above {sj}')
    problems = []
    marker = (snap / SNAP_MARKER).read_text().strip()
    if marker != commit:
        problems.append(f'{SNAP_MARKER} records {marker[:12]}, '
                        f'expected {commit[:12]}')
    for rel, want in sorted(digests.items()):
        if PurePosixPath(rel).is_absolute() or '..' in PurePosixPath(rel).parts:
            problems.append(f'{rel}: unsafe recorded path')
            continue
        f = snap / rel
        if not f.is_file() or f.is_symlink():
            problems.append(f'{rel}: missing from snapshot')
        elif _file_sha256(f) != want:
            problems.append(f'{rel}: content differs from the recorded sha256')
    return problems


# ------------------------------------------------------------------- lock

def read_lock(root):
    """Read .skills-lock.json, validating the full schema and path bounds.

    The lock is an execution input -- its `targets`/`links` drive file
    removals -- so it is validated as strictly as a program argument: only
    version 1, every provenance/digest field present and well-formed, and
    every managed path a <dir>/<name> relative path inside the project
    whose ancestors never resolve outside it.
    """
    path = root / LOCK_NAME
    if not path.is_file():
        return {'version': 1, 'skills': {}}
    try:
        lock = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f'install-base: cannot read {LOCK_NAME}: {exc}')

    def bad(what):
        raise SystemExit(f'install-base: {LOCK_NAME}: {what}')

    version = lock.get('version')
    if not isinstance(version, int) or isinstance(version, bool) or version != 1:
        bad(f'unsupported version {version!r} (this installer reads version 1)')
    skills = lock.get('skills')
    if not isinstance(skills, dict):
        bad('"skills" must be an object')
    required_keys = {
        'source_repo', 'source_path', 'source_commit', 'upstream',
        'sha256', 'required_by', 'targets', 'links',
    }
    for name, rec in skills.items():
        check_name(name)
        if not isinstance(rec, dict):
            bad(f'{name!r} must be an object')
        missing = sorted(required_keys - set(rec.keys()))
        if missing:
            bad(f'{name} missing required key(s): {", ".join(missing)}')
        repo = rec.get('source_repo')
        if not isinstance(repo, str) or not repo:
            bad(f'{name}.source_repo must be a non-empty string')
        spath = rec.get('source_path')
        spp = PurePosixPath(spath) if isinstance(spath, str) else PurePosixPath('.')
        if not isinstance(spath, str) or not spath or spp.is_absolute() \
                or '..' in spp.parts:
            bad(f'{name}.source_path must be a relative path inside the repository')
        commit = rec.get('source_commit')
        if not isinstance(commit, str) or not re.fullmatch(r'[0-9a-f]{40}', commit):
            bad(f'{name}.source_commit must be a full commit SHA')
        digest = rec.get('sha256')
        if not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):
            bad(f'{name}.sha256 must be a full sha256 hex digest')
        if not (rec.get('upstream') is None or isinstance(rec.get('upstream'), str)):
            bad(f'{name}.upstream must be a string or null')
        owners = rec.get('required_by')
        if not isinstance(owners, list) or not owners \
                or not all(isinstance(o, str) and NAME_RE.fullmatch(o) for o in owners):
            bad(f'{name}.required_by must be a non-empty list of names')
        targets, links = rec.get('targets'), rec.get('links')
        if not isinstance(targets, list) or not targets \
                or not all(isinstance(t, str) for t in targets):
            bad(f'{name}.targets must be a non-empty list of strings')
        if not isinstance(links, list) \
                or not all(isinstance(l, str) for l in links):
            bad(f'{name}.links must be a list of strings')
        for rel in targets + links:
            p = PurePosixPath(rel)
            if not rel or p.is_absolute() or '..' in p.parts:
                bad(f'{name} lists unsafe path {rel!r}')
            # managed payloads live at <something>/<name>; a lock entry may
            # never name a project-root file or an internal directory
            if len(p.parts) < 2 or p.name != name:
                bad(f'{name} lists path {rel!r} that is not a <dir>/{name} '
                    'managed path')
            if any(part == '.git' or part == SNAP_DIRNAME
                   or part.startswith(BACKUP_PREFIX) for part in p.parts):
                bad(f'{name} lists path {rel!r} inside a snapshot, backup '
                    'or .git directory')
            within((root / rel).parent, root, f'{LOCK_NAME} entry {rel!r}')
    return {'version': 1, 'skills': skills}


class Mutex:
    """Mutual exclusion over one lock file: create-or-fail, removed on exit."""

    def __init__(self, path):
        self.path = Path(path)
        self.fd = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        try:
            self.fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            raise SystemExit(f'install-base: another run holds {self.path} '
                             '(remove it only if that run is dead)')
        os.write(self.fd, f'{os.getpid()} {datetime.now().isoformat()}\n'.encode())
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)
        self.path.unlink(missing_ok=True)
        return False


def pending_journals(root):
    """Backup manifests of transactions that never finished nor rolled back.

    `tx_state` tracks the lifecycle (applying -> applied -> rolling-back
    -> rolled-back / rollback-failed / rollback-refused); anything short of
    'rolled-back' with evidence of an unfinished apply or a started but
    incomplete restore blocks new transactions. Legacy manifests without
    `tx_state` fall back to the `completed`/`rolled_back` markers, and a
    manifest written before `completed` existed counts as finished only
    when every op reached 'done'.
    """
    pending = []
    for m in root.rglob(f'{BACKUP_PREFIX}*/manifest.json'):
        try:
            data = json.loads(m.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        ops = data.get('ops')
        if not ops:
            continue
        if data.get('rolled_back') is True or data.get('tx_state') == 'rolled-back':
            continue
        tx = data.get('tx_state')
        restoring = any(o.get('restored') or o.get('restore_stage') for o in ops)
        if tx in ('applying', 'rolling-back', 'rollback-failed') \
                or data.get('rolled_back') is False or restoring:
            pending.append(m.parent)
            continue
        if not data.get('completed'):
            finished = all(o.get('state') == 'done' or o.get('done') for o in ops)
            if not finished:
                pending.append(m.parent)
    return sorted(pending)


# ------------------------------------------------------------------ checks

def check_name(name):
    if not NAME_RE.fullmatch(name):
        raise SystemExit(f'install-base: unsafe skill name {name!r}')


def within(path, root, what):
    """Resolve symlinks; require the result to stay inside root."""
    rp = path.expanduser().resolve()
    if rp != root and root not in rp.parents:
        raise SystemExit(f'install-base: {what} escapes project root: {path} -> {rp}')
    return rp


def check_targets_disjoint(targets):
    ordered = sorted(targets, key=str)
    for i, a in enumerate(ordered):
        for b in ordered[i + 1:]:
            if a == b or a in b.parents or b in a.parents:
                raise SystemExit(f'install-base: overlapping targets: {a} and {b}')


# ------------------------------------------------------------------- plan

def seq_backup(seq, path):
    rel = f'files/{seq[0]}/{path.name}'
    seq[0] += 1
    return rel


def plan(targets, entries, snap, link, retire, retired, payloads=None):
    """User-level plan: one entity per entry at every target.

    Names being explicitly installed are dropped from the retire list --
    the install's own evict step replaces them exactly once. `payloads`
    maps member names to staged payload dirs (snapshot copy plus injected
    legal files); unmapped entries link straight into the snapshot.
    """
    actions, ops = [], []
    seq = [0]
    installed = {e['name'] for e in entries}
    payloads = payloads or {}
    for target in targets:
        if not target.exists():
            ops.append({'op': 'mkdir', 'path': str(target)})
            actions.append((target, 'create', str(target)))
        if retire:
            for name in retired_names(retired, target):
                if name in installed:
                    continue
                stale = target / name
                if stale.exists() or stale.is_symlink():
                    ops.append({'op': 'move', 'path': str(stale), 'backup': seq_backup(seq, stale)})
                    actions.append((target, 'retire', f'{stale} -> <backup>/{stale.name}'))
        for entry in entries:
            src = payloads.get(entry['name'], snap / skill_dir(entry))
            dest = target / entry['name']
            if not src.is_dir():
                actions.append((target, 'skip', f"{entry['name']}: source missing ({src})"))
                continue
            if dest.is_symlink() and link and Path(dest.readlink()) == src:
                actions.append((target, 'keep', str(dest)))
                continue
            backup = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            if link:
                ops.append({'op': 'link', 'path': str(dest), 'target': str(src), 'backup': backup})
                actions.append((target, 'replace' if backup else 'install', f'{dest} -> {src}'))
            else:
                ops.append({'op': 'copy', 'from': str(src), 'path': str(dest), 'backup': backup})
                actions.append((target, 'replace' if backup else 'install', f'{src} -> {dest}'))
        for fname in INDEX_FILES:
            src, dest = snap / fname, target / fname
            if not src.is_file():
                continue
            if dest.is_file() and not dest.is_symlink() and dest.read_bytes() == src.read_bytes():
                actions.append((target, 'keep', str(dest)))
                continue
            rel = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            ops.append({'op': 'copy-file', 'from': str(src), 'path': str(dest), 'backup': rel})
            actions.append((target, 'index', f'{dest}' + (f' (old -> <backup>/{dest.name})' if rel else ' (new)')))
    return actions, ops


def rel_link(from_dir, to_path):
    return os.path.relpath(str(to_path), str(from_dir))


def remove_ops(root, rec, ops, seq):
    """Ops that move an un-owned skill's payloads and links into backup.

    Entries come from the lock, so re-check bounds at plan time: the leaf
    itself may be a symlink (moved as a link, never followed) but its
    ancestors must resolve inside the project.
    """
    actions = []
    for rel in rec['links'] + rec['targets']:
        p = root / rel
        within(p.parent, root, f'{LOCK_NAME} entry {rel!r}')
        if p.exists() or p.is_symlink():
            ops.append({'op': 'move', 'path': str(p), 'backup': seq_backup(seq, p)})
            actions.append((p.parent, 'remove', f'{p} -> <backup>/{p.name}'))
    return actions


def plan_project(root, primaries, link_roots, members, snap, lock, owner,
                 update=False, force=False, meta=None, payloads=None):
    """Project plan: one real copy per entity in each primary root, relative
    symlinks in link roots, and a merged .skills-lock.json.

    `payloads` maps member names to their final payload directory (staged
    copies carrying provenance/license files); unstaged members install
    straight from the snapshot. Digests and lock entries describe that
    final payload, never the pre-augmentation source.

    Same name + same source path + same upstream + same digest -> identical
    entity: keep it and merge required_by. Same name but anything different
    -> a different entity: refuse instead of silently swapping or renaming.
    An update may not change a payload other owners still claim unless
    --force; untouched members keep their recorded provenance, so the lock
    only ever reports the commit each entity actually came from.
    """
    actions, ops = [], []
    seq = [0]
    skills = {n: dict(r) for n, r in lock['skills'].items()}
    payloads = payloads or {}
    digests = {m['name']: tree_digest(payloads.get(m['name'], snap / m['path']))
               for m in members}
    member_names = {m['name'] for m in members}
    modified, shared = [], []

    for m in members:
        name = m['name']
        src = payloads.get(name, snap / m['path'])
        upstream = upstream_repo_for(m['path'], meta['repo_map'])
        check_name(name)
        rec = skills.get(name)
        want = digests[name]
        if rec:
            # a different collection repo means a different entity entirely:
            # same path and content is not enough to share it or merge
            # owners across collections without an explicit --force
            if rec.get('source_repo') != meta['collection_id'] and not force:
                raise SystemExit(
                    f"install-base: '{name}' was installed from collection "
                    f"{rec.get('source_repo')!r}, but this install comes from "
                    f"{meta['collection_id']!r}; refusing to mix entities "
                    'across collection repos without --force')
            # a different source path or upstream, or a different payload
            # outside an update, means a different entity under the same name
            if rec['source_path'] != m['path'] \
                    or rec['upstream'] != upstream \
                    or (not update and rec['sha256'] != want):
                raise SystemExit(
                    f"install-base: '{name}' is already installed from "
                    f"{rec['source_path']} ({rec['sha256'][:12]}…); requested {m['path']} "
                    f"({want[:12]}…). Same name, different entity: refusing to mix them.")
            if not update:
                # identical entity claimed by another owner: merge required_by,
                # but only while the on-disk payload still matches the lock
                state = {t: describe(root / t) for t in rec['targets']
                         if (root / t).exists() or (root / t).is_symlink()}
                drift = [t for t, d in state.items() if d['sha256'] != rec['sha256']]
                drift += [t for t in rec['targets'] if t not in state]
                if drift:
                    raise SystemExit(
                        f"install-base: '{name}' diverged from {LOCK_NAME} at:\n  "
                        + '\n  '.join(drift)
                        + '\nrepair with --update --force instead of adding owners')
                rec['required_by'] = sorted(set(rec['required_by']) | {owner})
                rec.setdefault('upstream', upstream)
                actions.append((primaries[0], 'dedup',
                                f"{name} shared by {rec['required_by']}"))
                continue
            state = {t: describe(root / t) for t in rec['targets']
                     if (root / t).exists() or (root / t).is_symlink()}
            dirty = [t for t, d in state.items() if d['sha256'] != rec['sha256']]
            missing = [t for t in rec['targets'] if t not in state]
            missing += [l for l in rec.get('links', [])
                        if not (root / l).is_symlink()]
            if dirty and not force:
                modified += dirty
                continue
            if want != rec['sha256'] \
                    and set(rec['required_by']) - {owner} and not force:
                shared.append(f"{name} (also required by "
                              f"{sorted(set(rec['required_by']) - {owner})})")
                continue
            rec['required_by'] = sorted(set(rec['required_by']) | {owner})
            if not dirty and not missing and want == rec['sha256']:
                rec.setdefault('upstream', upstream)
                actions.append((primaries[0], 'keep', f'{name} unchanged'))
                continue
            # new version, dirty+force, or partially missing: replace
        targets_rel = [str((p / name).relative_to(root)) for p in primaries]
        links_rel = [str((lr / name).relative_to(root)) for lr in link_roots]
        for primary in primaries:
            dest = primary / name
            if rec is None and (dest.exists() or dest.is_symlink()):
                raise SystemExit(f'install-base: {dest} exists but is not in {LOCK_NAME}; '
                                 'refusing to overwrite un-managed content')
            backup = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            ops.append({'op': 'copy', 'from': str(src), 'path': str(dest), 'backup': backup})
            actions.append((primary, 'replace' if backup else 'install', f'{src} -> {dest}'))
        for lr in link_roots:
            dest = lr / name
            link_to = rel_link(dest.parent, primaries[0] / name)
            if dest.is_symlink() and os.readlink(dest) == link_to:
                continue
            if (dest.exists() or dest.is_symlink()) and rec is None:
                raise SystemExit(f'install-base: {dest} exists but is not in {LOCK_NAME}; '
                                 'refusing to overwrite un-managed content')
            backup = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            ops.append({'op': 'link', 'path': str(dest), 'target': link_to, 'backup': backup})
            actions.append((lr, 'link', f'{dest} -> {link_to}'))
        skills[name] = {'source_repo': meta['collection_id'],
                        'source_path': m['path'], 'source_commit': meta['sha'],
                        'upstream': upstream, 'sha256': want,
                        'required_by': sorted(set((rec or {}).get('required_by', [])) | {owner}),
                        'targets': targets_rel, 'links': links_rel}
    if modified:
        raise SystemExit('install-base: locally modified skills would be lost; re-run '
                         'with --force (modified copies move to the backup dir first):\n  '
                         + '\n  '.join(modified))
    if shared:
        raise SystemExit('install-base: this update changes skills other owners '
                         'still require; co-update every owner, or re-run with '
                         '--force to change them for all owners:\n  '
                         + '\n  '.join(shared))

    if update:
        for name, rec in skills.items():
            if owner in rec['required_by'] and name not in member_names:
                rec['required_by'] = [r for r in rec['required_by'] if r != owner]
                if not rec['required_by']:
                    actions += remove_ops(root, rec, ops, seq)
        skills = {n: r for n, r in skills.items() if r['required_by']}

    for d in primaries + link_roots:
        if not d.exists():
            ops.insert(0, {'op': 'mkdir', 'path': str(d)})
            actions.append((d, 'create', str(d)))
    for primary in primaries:
        for fname in INDEX_FILES:
            src, dest = snap / fname, primary / fname
            if not src.is_file():
                continue
            if dest.is_file() and not dest.is_symlink() and dest.read_bytes() == src.read_bytes():
                continue
            rel = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            ops.append({'op': 'copy-file', 'from': str(src), 'path': str(dest), 'backup': rel})
            actions.append((primary, 'index', str(dest)))
    for lr in link_roots:
        for fname in INDEX_FILES:
            src, dest = primaries[0] / fname, lr / fname
            if not (snap / fname).is_file():
                continue
            link_to = rel_link(dest.parent, src)
            if dest.is_symlink() and os.readlink(dest) == link_to:
                continue
            rel = seq_backup(seq, dest) if (dest.exists() or dest.is_symlink()) else None
            ops.append({'op': 'link', 'path': str(dest), 'target': link_to, 'backup': rel})
            actions.append((lr, 'index', f'{dest} -> {link_to}'))

    new_lock = {'version': 1, 'skills': {n: r for n, r in sorted(skills.items())}}
    ops.append({'op': 'write-json', 'path': str(root / LOCK_NAME), 'data': new_lock,
                'backup': seq_backup(seq, root / LOCK_NAME) if (root / LOCK_NAME).exists() else None})
    actions.append((root, 'lock', str(root / LOCK_NAME)))
    return actions, ops, new_lock


def plan_uninstall(root, lock, suite):
    actions, ops = [], []
    seq = [0]
    skills = {n: dict(r) for n, r in lock['skills'].items()}
    touched = [n for n, r in skills.items() if suite in r['required_by']]
    if not touched:
        raise SystemExit(f"install-base: suite {suite!r} owns nothing in {LOCK_NAME}")
    for name in touched:
        rec = skills[name]
        rec['required_by'] = [r for r in rec['required_by'] if r != suite]
        if rec['required_by']:
            actions.append((root, 'keep', f"{name} still required by {rec['required_by']}"))
        else:
            actions += remove_ops(root, rec, ops, seq)
    skills = {n: r for n, r in skills.items() if r['required_by']}
    ops.append({'op': 'write-json', 'path': str(root / LOCK_NAME),
                'data': {'version': 1, 'skills': dict(sorted(skills.items()))},
                'backup': seq_backup(seq, root / LOCK_NAME)
                if (root / LOCK_NAME).exists() else None})
    actions.append((root, 'lock', str(root / LOCK_NAME)))
    return actions, ops


def show(source, sha, ref, mode, method, backup_dir, names, actions):
    print(f'source: {source}')
    print(f'ref:    {sha}' + (f' ({ref})' if ref != sha else ''))
    print(f'mode:   {mode}  method: {method}')
    print(f'backup: {backup_dir}')
    print(f"skills: {', '.join(names)}")
    shown = None
    for target, action, detail in actions:
        if target != shown:
            shown = target
            print(f'\n[{target}]')
        print(f'  {action:8} {detail}')


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--dry-run', action='store_true', help='show actions only (default)')
    mode.add_argument('--apply', action='store_true', help='perform the install')
    mode.add_argument('--rollback', type=Path, metavar='BACKUP_DIR',
                      help='restore a previous install from its backup directory')
    mode.add_argument('--verify-source', type=Path, metavar='SOURCE_JSON',
                      help='verify an installed ask-me snapshot against its '
                           'recorded digests (path to source.json or its dir)')
    parser.add_argument('--project', action='store_true',
                        help='copy into ./.agents/skills (+ ./.claude/skills links) with a lock')
    parser.add_argument('--suite', help='install a suite from suites/<name>.json (project only)')
    parser.add_argument('--update', action='store_true',
                        help='re-apply --suite at --ref, replacing only unmodified skills')
    parser.add_argument('--uninstall', metavar='SUITE',
                        help='drop SUITE ownership; remove skills left with no owner')
    parser.add_argument('--force', action='store_true',
                        help='with --update: replace locally modified skills (old copy backed up)')
    parser.add_argument('--source', type=Path, default=DEFAULT_SOURCE,
                        help='clone to install from (default: %(default)s)')
    parser.add_argument('--ref',
                        help='commit-ish inside --source to install (resolved to a full SHA)')
    parser.add_argument('--target', action='append', type=Path,
                        help='override install targets (repeatable; bounded to the project with --project)')
    parser.add_argument('--skill', action='append',
                        help='install these index names or paths (repeatable); default: base suite')
    parser.add_argument('--list', action='store_true', help='list index entries and exit')
    args = parser.parse_args()

    if args.rollback:
        do_rollback(args.rollback.expanduser().resolve())
        return
    if args.verify_source:
        problems = verify_source(args.verify_source.expanduser().resolve())
        if problems:
            raise SystemExit('install-base: source verification failed:\n  '
                             + '\n  '.join(problems))
        print('source verified.')
        return
    if args.suite and not args.project:
        parser.error('--suite requires --project')
    if args.update and not args.suite:
        parser.error('--update requires --suite')
    if args.uninstall and not args.project:
        parser.error('--uninstall requires --project')
    if args.force and not args.update:
        parser.error('--force only applies to --update')
    if args.suite and args.skill:
        parser.error('--suite and --skill are mutually exclusive')

    root = Path.cwd().resolve()

    if args.uninstall:
        with Mutex(root / (LOCK_NAME + '.lock')):
            if args.apply and pending_journals(root):
                raise SystemExit(
                    'install-base: unfinished transactions found; run '
                    '--rollback on each first:\n  ' + '\n  '.join(
                        str(p) for p in pending_journals(root)))
            lock = read_lock(root)
            ts = datetime.now().strftime('%Y%m%d-%H%M%S')
            backup_dir = backup_dir_for(
                [root / PROJECT_PRIMARY] + [root / p for p in PROJECT_LINK_ROOTS], ts)
            actions, ops = plan_uninstall(root, lock, args.uninstall)
            show('(lock)', '-', '-', 'APPLY' if args.apply else 'DRY-RUN', 'remove',
                 backup_dir, sorted(lock['skills']), actions)
            if not args.apply:
                print('\nDry run only; re-run with --apply to uninstall.')
                return
            make_backup_dir(backup_dir)
            manifest_path = backup_dir / 'manifest.json'
            manifest = {'created': ts, 'mode': 'uninstall', 'root': str(root),
                        'suite': args.uninstall, 'ops': ops,
                        'tx_state': 'applying'}
            write_json_atomic(manifest_path, manifest)
            run_ops(ops, backup_dir, manifest, manifest_path)
            print(f'\nDone. Backup: {backup_dir} (restore with --rollback {backup_dir})')
        return

    source = args.source.expanduser().resolve()
    if args.list:
        skills, base, _, _ = load_source_index(source)
        counts = {}
        for e in skills:
            counts[e['name']] = counts.get(e['name'], 0) + 1
        for e in skills:
            qual = skill_dir(e) if counts[e['name']] > 1 else ''
            mark = '*' if e['name'] in base else ' '
            print(f"{mark} {e['name']:32} {e['suite']:12} {qual or e['path']}")
        print('(* = base suite; ambiguous names resolve only by full path)')
        return
    if not args.ref:
        parser.error('--ref is required (the commit-ish inside --source to install)')
    sha = resolve_commit(source, args.ref)
    ts = datetime.now().strftime('%Y%m%d-%H%M%S')

    if args.project:
        primaries = [within(t, root, '--target') for t in args.target] \
            if args.target else [within(Path(PROJECT_PRIMARY), root, 'target')]
        link_roots = [] if args.target else \
            [within(Path(p), root, 'target') for p in PROJECT_LINK_ROOTS]
        targets = primaries + link_roots
        snap_root = within(Path(SNAP_DIRNAME), root, 'snapshot dir')
        for t in targets:
            if t == snap_root or snap_root in t.parents or t in snap_root.parents:
                raise SystemExit(f'install-base: target overlaps snapshot dir: {t}')
            if t == root:
                raise SystemExit('install-base: refusing to use the project root as a target')
    else:
        primaries, link_roots = [], []
        targets = [t.expanduser().resolve() for t in (args.target or USER_TARGETS)]
        parents = {t.parent for t in targets}
        base_dir = Path(os.path.commonpath([str(p) for p in parents])) \
            if len(parents) > 1 else next(iter(parents))
        snap_root = base_dir / SNAP_DIRNAME
    check_targets_disjoint(targets)

    # dry-run must write nothing: export into a scratch dir instead of the
    # persistent snapshot root
    scratch = None
    if not args.apply:
        scratch = tempfile.TemporaryDirectory(prefix='install-base-dry-')
        snap_root = Path(scratch.name)

    # selection metadata comes straight from the commit (git show), the
    # payload from one immutable export of everything the install needs
    skills, base, retired, _src = parse_source_index(
        git_show(source, sha, 'index.json'),
        git_show(source, sha, '.sync/index-source.json'), f'{source}@{sha}')
    repo_map = load_repo_map(git_show(source, sha, '.sync/upstreams.json'))

    if args.suite:
        suite, members = expand_suite(
            lambda n: git_show(source, sha, f'suites/{n}.json'), args.suite)
        names = [m['name'] for m in members]
    else:
        entries = closure(resolve_selectors(args.skill or base, skills), skills)
        members = [{'name': e['name'], 'path': skill_dir(e), 'depends': []} for e in entries]
        names = [e['name'] for e in entries]
        suite = None
    # the snapshot is the whole tree at sha: content-addressed and
    # complete, so later installs at the same commit can always reuse it
    snap = export_snapshot(source, sha, ['.'], snap_root)
    for m in members:
        if not (snap / m['path']).is_dir():
            raise SystemExit(f"install-base: member path missing in commit "
                             f"{sha[:12]}: {m['path']}")

    check_final_names(members)
    stage_root = None
    # the project transaction holds its mutex from the lock read through
    # planning, apply, and failure recovery -- payload and lock move together
    guard = Mutex(root / (LOCK_NAME + '.lock')) if args.project \
        else contextlib.nullcontext()
    with guard:
        meta = {'repo_map': repo_map, 'source': source, 'sha': sha,
                'snap': snap, 'collection_id': collection_repo(source),
                'entries': skills,
                'license_map': license_map_for(
                    git_show(source, sha, '.sync/upstreams.json'))}
        if args.project:
            if args.apply:
                pending = pending_journals(root)
                if pending:
                    raise SystemExit(
                        'install-base: unfinished transactions found; run '
                        '--rollback on each before applying:\n  '
                        + '\n  '.join(str(p) for p in pending))
            lock = read_lock(root)
            owner = args.suite or EXPLICIT
            stage_root = Path(tempfile.mkdtemp(prefix='.ib-payload-',
                                               dir=str(snap_root)))
            payloads = stage_payloads(members, snap, meta, stage_root)
            actions, ops, new_lock = plan_project(
                root, primaries, link_roots, members, snap, lock, owner,
                update=args.update, force=args.force,
                meta=meta, payloads=payloads)
            method = 'copy+links'
        else:
            payloads = stage_user_payloads(members, snap, meta, snap_root, sha)
            actions, ops = plan(targets, entries, snap, True, True, retired,
                                payloads)
            method = 'symlink'

        try:
            backup_dir = backup_dir_for(targets or [root], ts)
            show(source, sha, args.ref, 'APPLY' if args.apply else 'DRY-RUN', method,
                 backup_dir, names, actions)
            if suite and suite.get('note'):
                print(f"\nnote: {suite['note']}")

            if not args.apply:
                print('\nDry run only; re-run with --apply to install.')
                if scratch:
                    scratch.cleanup()
                return
            if not ops:
                print('\nNothing to do.')
                return
            make_backup_dir(backup_dir)
            manifest_path = backup_dir / 'manifest.json'
            manifest = {'created': ts, 'source': str(source), 'commit': sha,
                        'mode': 'project' if args.project else 'user',
                        'root': str(root), 'ops': ops,
                        'tx_state': 'applying'}
            write_json_atomic(manifest_path, manifest)
            run_ops(ops, backup_dir, manifest, manifest_path)
            print(f'\nDone. Backup: {backup_dir} (restore with --rollback {backup_dir})')
        finally:
            if stage_root is not None:
                shutil.rmtree(stage_root, ignore_errors=True)


if __name__ == '__main__':
    main()
